.DS_Store
**/__pycache__/
*.pyc
*.pyo
**/.venv/

# Never publish upstream clones or their local environments.
external/

# Q3 keeps the handpicked sample inputs/outputs, but not cached URL downloads.
question_3_faster_rcnn/inputs/downloaded/

# Q4 keeps curated sample media, but not raw YOLO run directories.
question_4_yolo11_yolov12/runs/

# Q5 keeps only a small curated input set plus the placeholder note.
question_5_semantic_segmentation/datasets/
question_5_semantic_segmentation/models/


# Q7 training assets stay local, but the written summaries can be tracked.
question_7_transfer_learning/datasets/
question_7_transfer_learning/datasets_smoke/
question_7_transfer_learning/logs/
question_7_transfer_learning/visualizations/
question_7_transfer_learning/outputs/*
!question_7_transfer_learning/outputs/**/
!question_7_transfer_learning/outputs/**/summary.json
!question_7_transfer_learning/outputs/**/summary.md
